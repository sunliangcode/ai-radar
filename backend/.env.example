# Core LLM (optional — heuristic mode if empty / placeholder)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Delivery (configure at least one to receive daily push)
FEISHU_WEBHOOK_URL=
WEBHOOK_URL=
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TO=

# Optional source tokens
# GITHUB_TOKEN=
# PH_TOKEN=
# APIFY_TOKEN=
# APIFY_TWITTER_ACTOR=altimis~scweet
# RSSHUB_BASE=https://rsshub.umzzz.com

# Optional email ingest (IMAP)
# EMAIL_INGEST_ENABLED=false
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USERNAME=
# IMAP_PASSWORD=
# IMAP_PROTOCOL=imaps
# IMAP_FOLDER=INBOX

# Optional full-article enrichment for short RSS snippets
# WEB_FETCH_ENABLED=false
# WEB_FETCH_PARALLELISM=4

# Optional
# SMTP_PORT=587
# SMTP_FROM=
# LOCAL_TOKEN=
