# =============================================================================
# AI Radar — deploy-time configuration
# Customer UI only edits: interests, language, inbox email, Feishu bind, push time.
# Everything below is for the person who runs the server (copy to backend/.env).
# =============================================================================

# --- LLM (not shown in customer Settings) ---
# Default: local Ollama (no API key required for localhost).
# Change when you switch models or use a cloud OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen3.5:2b-mlx
# Prompt + completion must fit this window. Also sent as Ollama options.num_ctx.
OPENAI_CONTEXT_WINDOW_TOKENS=8192
OPENAI_MAX_COMPLETION_TOKENS=1024
# Ollama model residency after each local call ("5m", "0" = unload, "-1" = forever)
OPENAI_KEEP_ALIVE=0
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BACKOFF_MS=500
# Accepted for compatibility; backend always runs LLM single-threaded.
AI_PARALLELISM=1
# After a failed model call, use rules for this long instead of retrying every batch (ms).
AI_FAILURE_COOLDOWN_MS=60000

# News fetch HTTP read timeout (ms). Pipeline knobs (score threshold, lookback, …)
# live in application.yml with product defaults — override there only if needed.
FETCH_TIMEOUT_MS=60000

# --- Title translate sidecar (en→zh display titles; not LLM) ---
# RADAR_TRANSLATE_ENABLED=true
# RADAR_TRANSLATE_URL=http://127.0.0.1:8765

# =============================================================================
# Delivery
# Customer path: Settings → Preferences — inbox email + Feishu scan-to-bind.
# Deployer path: SMTP transport + optional legacy webhooks below.
# =============================================================================

# --- Email transport (deployer only; customer only fills the inbox address in UI) ---
# Required for email push: host (+ usually username/password).
# Without these, the UI shows “email not ready” and hides the inbox field.
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional seed for the customer inbox field; UI/DB wins once the user saves.
SMTP_TO=
# Optional: SMTP_PORT=587  SMTP_FROM=  SMTP_STARTTLS=true

# --- Feishu ---
# Preferred: customer scans QR in Settings (creates app + binds open_id). No env needed.
# Legacy fallback only: custom-bot webhook if you already have one (UI no longer shows this).
FEISHU_WEBHOOK_URL=

# --- Generic webhook (ops / integrations; not in customer UI) ---
WEBHOOK_URL=
# WEBHOOK_HEADERS={"Authorization":"Bearer …"}

# --- Optional source tokens ---
# GITHUB_TOKEN=
# PH_TOKEN=
# APIFY_TOKEN=
# APIFY_TWITTER_ACTOR=altimis~scweet
# RSSHUB_BASE=https://rsshub.umzzz.com

# --- Optional email ingest (IMAP → feed items; unrelated to SMTP push) ---
# EMAIL_INGEST_ENABLED=false
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USERNAME=
# IMAP_PASSWORD=
# IMAP_PROTOCOL=imaps
# IMAP_FOLDER=INBOX

# --- Optional full-article enrichment for short RSS snippets ---
# WEB_FETCH_ENABLED=false
# WEB_FETCH_PARALLELISM=4

# --- Optional local UI gate ---
# LOCAL_TOKEN=
