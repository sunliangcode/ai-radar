# Core LLM — defaults to local Ollama (no API key required for localhost)
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen3.5:2b-mlx
# Context budget (prompt + completion must fit); adjustable in Settings UI too
# Also sent as Ollama options.num_ctx for local endpoints so KV cache stays bounded
OPENAI_CONTEXT_WINDOW_TOKENS=8192
OPENAI_MAX_COMPLETION_TOKENS=1024
# Ollama model residency after each local call ("5m", "0" = unload immediately, "-1" = forever)
OPENAI_KEEP_ALIVE=0
# Transient LLM failure retries (extra attempts after the first) and base backoff ms
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BACKOFF_MS=500
# Concurrent LLM calls for score/summarize (1–8); adjustable in Settings → LLM
AI_PARALLELISM=1
# News fetch HTTP read timeout (ms); adjustable in Settings → Advanced
FETCH_TIMEOUT_MS=60000

# Delivery (configure at least one to receive daily push)
FEISHU_WEBHOOK_URL=
WEBHOOK_URL=
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TO=

# Optional source tokens
# GITHUB_TOKEN=
# PH_TOKEN=
# APIFY_TOKEN=
# APIFY_TWITTER_ACTOR=altimis~scweet
# RSSHUB_BASE=https://rsshub.umzzz.com

# Optional email ingest (IMAP)
# EMAIL_INGEST_ENABLED=false
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USERNAME=
# IMAP_PASSWORD=
# IMAP_PROTOCOL=imaps
# IMAP_FOLDER=INBOX

# Optional full-article enrichment for short RSS snippets
# WEB_FETCH_ENABLED=false
# WEB_FETCH_PARALLELISM=4

# Optional
# SMTP_PORT=587
# SMTP_FROM=
# LOCAL_TOKEN=
